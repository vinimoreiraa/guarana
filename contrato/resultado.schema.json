{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guaraná resultado de analise",
  "description": "Contrato unico usado pelo app, pelo motor local e pela API. Triagem, nunca diagnostico.",
  "type": "object",
  "required": ["engine", "status", "quality", "signs", "triage", "needs_cloud_review", "model_version"],
  "additionalProperties": false,
  "properties": {
    "engine": { "type": "string", "enum": ["local-rules", "local-model", "cloud-vlm"] },
    "status": { "type": "string", "enum": ["provisional", "confirmed", "divergent"] },
    "model_version": { "type": "string" },
    "quality": {
      "type": "object",
      "required": ["ok", "issues"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string", "enum": ["desfoque", "escura", "superexposta", "reflexo", "olho_fora_do_quadro", "nao_e_olho"] } }
      }
    },
    "signs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "confidence", "region", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": [
            "hiperemia", "ictericia", "palidez_conjuntival",
            "arco_corneano", "opacidade_corneana", "esclera_azul", "hemorragia_subconjuntival",
            "pterigio_pinguecula", "manchas_bitot", "ocronose", "telangiectasia",
            "lesao_pigmentada", "catarata_leucocoria" ] },
          "state": { "type": "string", "enum": ["present", "candidate", "absent"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "region": { "type": "string", "enum": ["esclera", "conjuntiva", "cornea", "limbo", "iris", "pupila", "palpebra"] },
          "evidence": { "type": "string", "description": "medicao ou justificativa curta, ex.: b* medio 21 acima do limiar 15" }
        }
      }
    },
    "triage": { "type": "string", "enum": ["sem_sinais", "observar", "encaminhar", "encaminhar_urgente"] },
    "needs_cloud_review": { "type": "boolean" },
    "triage_reasons": { "type": "array", "items": { "type": "string" }, "description": "Motivos vindos da ficha do cidadão (ex.: diabetes sem fundo de olho há >12 meses) que elevaram a triagem além do que a foto mostra. Opcional." }
  }
}
